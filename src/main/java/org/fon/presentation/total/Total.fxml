<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.fon.presentation.total.TotalPresenter">
   <VBox prefHeight="600.0" prefWidth="1200.0" spacing="20.0">
      <children>
          <TableView fx:id="table" prefHeight="292.0" prefWidth="1200.0" styleClass="table-view1">
              <columns>
                  <TableColumn fx:id="category" editable="false" prefWidth="200.0" resizable="false" sortable="false" text="Fon Türü" />
                  <TableColumn fx:id="totalPrice" editable="false" prefWidth="166.0" resizable="false" sortable="false" text="Toplam Maliyet" />
                  <TableColumn fx:id="todayTotalPrice" editable="false" prefWidth="166.0" resizable="false" sortable="false" text="Bugünkü Değer" />
                  <TableColumn fx:id="profit" editable="false" minWidth="8.0" prefWidth="125.0" resizable="false" sortable="false" text="K/Z" />
                  <TableColumn fx:id="profitPercentage" editable="false" minWidth="0.0" prefWidth="125.0" resizable="false" sortable="false" text="\% K/Z" />
                  <TableColumn fx:id="changePercentage" editable="false" prefWidth="125.0" resizable="false" sortable="false" text="\% Değişim" />
                  <TableColumn fx:id="change" editable="false" prefWidth="126.0" resizable="false" sortable="false" text="Değişim" />
                  <TableColumn fx:id="demand" editable="false" prefWidth="166.0" resizable="false" sortable="false" text="Talep Edildi" />
              </columns>
          </TableView>
         <TableView fx:id="table1" prefHeight="42.0" prefWidth="1200.0">
            <columns>
               <TableColumn fx:id="category1" editable="false" prefWidth="200.0" resizable="false" sortable="false" text="Fon Türü" />
               <TableColumn fx:id="totalPrice1" editable="false" prefWidth="166.0" resizable="false" sortable="false" text="Toplam Maliyet" />
               <TableColumn fx:id="todayTotalPrice1" editable="false" prefWidth="166.0" resizable="false" sortable="false" text="Bugünkü Değer" />
               <TableColumn fx:id="profit1" editable="false" minWidth="8.0" prefWidth="125.0" resizable="false" sortable="false" text="K/Z" />
               <TableColumn fx:id="profitPercentage1" editable="false" minWidth="0.0" prefWidth="125.0" resizable="false" sortable="false" text="\% K/Z" />
               <TableColumn fx:id="changePercentage1" editable="false" prefWidth="125.0" resizable="false" sortable="false" text="\% Değişim" />
               <TableColumn fx:id="change1" editable="false" prefWidth="126.0" resizable="false" sortable="false" text="Değişim" />
               <TableColumn fx:id="demand1" editable="false" prefWidth="166.0" resizable="false" sortable="false" text="Talep Edildi" />
            </columns>
            <VBox.margin>
               <Insets top="-20.0" />
            </VBox.margin>
            <styleClass>
               <String fx:value="headless" />
               <String fx:value="table-view1" />
            </styleClass>
         </TableView>
         <HBox prefHeight="160.0" prefWidth="1200.0" spacing="20.0">
            <children>
               <ComboBox fx:id="categoryComboBox" prefHeight="45.0" prefWidth="150.0">
                  <HBox.margin>
                     <Insets top="70.0" />
                  </HBox.margin>
               </ComboBox>
               <VBox spacing="10.0">
                  <children>
                     <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="40.0" prefWidth="150.0" styleClass="label1" text="Fon Adı" textAlignment="CENTER" />
                     <TextField fx:id="nameTextField" alignment="CENTER" prefHeight="45.0" />
                  </children>
                  <padding>
                     <Insets bottom="20.0" top="20.0" />
                  </padding>
               </VBox>
               <VBox spacing="10.0">
                  <children>
                     <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="40.0" prefWidth="150.0" styleClass="label1" text="Adet" textAlignment="CENTER" />
                     <TextField fx:id="countTextField" alignment="CENTER" prefHeight="45.0" text="0" />
                  </children>
                  <padding>
                     <Insets bottom="20.0" top="20.0" />
                  </padding>
               </VBox>
               <VBox spacing="10.0">
                  <children>
                     <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="40.0" prefWidth="150.0" styleClass="label1" text="Birim Maliyet" textAlignment="CENTER" />
                     <TextField fx:id="priceTextField" alignment="CENTER" prefHeight="45.0" text="0" />
                  </children>
                  <padding>
                     <Insets bottom="20.0" top="20.0" />
                  </padding>
               </VBox>
               <VBox spacing="10.0">
                  <children>
                     <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="40.0" prefWidth="150.0" styleClass="label1" text="Talep Edildi" textAlignment="CENTER" />
                     <TextField fx:id="demandTextField" alignment="CENTER" prefHeight="45.0" text="0" />
                  </children>
                  <padding>
                     <Insets bottom="20.0" top="20.0" />
                  </padding>
               </VBox>
               <VBox prefHeight="160.0" prefWidth="140.0" spacing="20.0">
                  <children>
                     <Button fx:id="ekleButton" mnemonicParsing="false" onAction="#newEntry" prefHeight="50.0" prefWidth="140.0" styleClass="button1" text="Ekle" />
                     <Button fx:id="updateButton" mnemonicParsing="false" onAction="#updatePrices" prefHeight="50.0" prefWidth="140.0" styleClass="button1" text="Fiyatları Güncelle" />
                  </children>
                  <padding>
                     <Insets bottom="20.0" top="20.0" />
                  </padding>
               </VBox>
            </children>
            <padding>
               <Insets left="20.0" right="20.0" />
            </padding>
         </HBox>
      </children>
   </VBox>
</AnchorPane>
